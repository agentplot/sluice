{ pkgs, config, ... }:

let
  rust = config.languages.rust.toolchain;

  # The lint gate. Its own PATH carries the devenv toolchain, because a git
  # hook runs outside any shell a session opened.
  lint = pkgs.writeShellApplication {
    name = "lint";
    runtimeInputs = [
      rust.cargo
      rust.clippy
      rust.rustc
      pkgs.git
    ];
    text = ''
      cd "$(git rev-parse --show-toplevel)"
      cargo clippy --workspace --all-targets -- -D warnings
    '';
  };

  # target/ grows unseen across worktrees until the disk is full.
  disk = pkgs.writeShellApplication {
    name = "disk";
    runtimeInputs = [
      pkgs.git
      pkgs.coreutils
      pkgs.gawk
    ];
    text = ''
      root="$(git rev-parse --show-toplevel)"
      limit=''${SLUICE_TARGET_LIMIT_GB:-25}
      target=0
      [ -d "$root/target" ] && target=$(($(du -sk "$root/target" | cut -f1) / 1048576))
      used="$(df -P "$root" | awk 'NR == 2 { print $5 }' | tr -d '%')"
      echo "target/ ''${target} GB, the disk ''${used} per cent full"
      status=0
      if [ "$target" -gt "$limit" ]; then
        echo "target/ is ''${target} GB, over the ''${limit} GB bar: run 'cargo clean' here and in the worktrees beside this one" >&2
        status=1
      fi
      if [ "$used" -ge 90 ]; then
        echo "the disk is ''${used} per cent full: a build on a full disk is slow and its processes are killed" >&2
        status=1
      fi
      exit $status
    '';
  };

  # prek writes the config path into the hook it generates, and .git/hooks is
  # shared by every worktree: make the hook read the config of the worktree
  # the commit is in (as flywheel-next does).
  hooks-per-worktree = pkgs.writeShellApplication {
    name = "hooks-per-worktree";
    runtimeInputs = [
      pkgs.git
      pkgs.gnugrep
      pkgs.gnused
      pkgs.diffutils
      pkgs.coreutils
    ];
    text = ''
      hooks="$(git rev-parse --git-common-dir)/hooks"
      [ -d "$hooks" ] || exit 0
      # shellcheck disable=SC2016
      dynamic='--config="$(git rev-parse --show-toplevel)/.pre-commit-config.yaml"'
      for hook in "$hooks"/*; do
        [ -f "$hook" ] || continue
        grep -q 'File generated by prek' "$hook" || continue
        tmp="$hook.worktree"
        sed "s|--config=\"[^\"]*\"|$dynamic|" "$hook" >"$tmp"
        if cmp -s "$hook" "$tmp"; then
          rm -f "$tmp"
        else
          chmod --reference="$hook" "$tmp" && mv -f "$tmp" "$hook"
        fi
      done
    '';
  };

in
{
  # The toolchain is this file's, pinned by devenv.lock: every cargo and moon
  # command in this repository runs inside `devenv shell`.
  languages.rust.enable = true;

  packages = [
    pkgs.git
    pkgs.jq
    pkgs.moon
  ];

  # moon's task archives (.moon/cache/outputs) are a link into the git common
  # dir, so every worktree of sluice shares them: a crate's tests that passed
  # in one worktree replay in another. The rest of .moon/cache records the
  # checkout's absolute paths and stays its own. moon runs the shell's tools,
  # never proto's.
  enterShell = ''
    if _moon_common="$(git -C "${config.devenv.root}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
      _moon_cache="${config.devenv.root}/.moon/cache"
      [ -L "$_moon_cache" ] && rm -f "$_moon_cache"
      mkdir -p "$_moon_common/moon-outputs" "$_moon_cache"
      if [ ! -L "$_moon_cache/outputs" ]; then
        rm -rf "$_moon_cache/outputs"
        ln -s "$_moon_common/moon-outputs" "$_moon_cache/outputs"
      fi
    fi
    unset _moon_common _moon_cache
    export MOON_TOOLCHAIN_FORCE_GLOBALS=true
  '';

  treefmt.enable = true;
  treefmt.config = {
    imports = [ ./treefmt.nix ];
    programs.rustfmt.package = rust.rustfmt;
  };

  # `devenv shell -- suite`: every crate's tests through moon, replaying a
  # crate whose inputs already passed.
  scripts.suite = {
    description = "The test suite: moon run of every task tagged suite";
    exec = ''
      set -euo pipefail
      cd ${config.devenv.root}
      moon run ':#suite' "$@" </dev/null
    '';
  };

  # `devenv shell -- affected`: only the crates a change touches, and those
  # depending on them.
  scripts.affected = {
    description = "The suite for what changed since main: moon run --affected";
    exec = ''
      set -euo pipefail
      cd ${config.devenv.root}
      moon run ':#suite' --affected --downstream deep "$@" </dev/null
    '';
  };

  scripts.lint = {
    description = "The lint gate: cargo clippy -D warnings";
    exec = ''exec ${lint}/bin/lint "$@"'';
  };
  scripts.disk = {
    description = "What target/ and the disk have grown to";
    exec = ''exec ${disk}/bin/disk "$@"'';
  };

  # The floor under every commit, installed into the common hooks directory
  # on `devenv shell`.
  git-hooks.hooks = {
    treefmt.enable = true;
    clippy-gate = {
      enable = true;
      name = "clippy (-D warnings)";
      entry = "${lint}/bin/lint";
      files = "\\.rs$|Cargo\\.(toml|lock)$";
      pass_filenames = false;
    };
  };

  tasks."sluice:hooks:per-worktree" = {
    exec = "${hooks-per-worktree}/bin/hooks-per-worktree";
    after = [ "devenv:git-hooks:install" ];
    before = [ "devenv:enterShell" ];
  };
}
